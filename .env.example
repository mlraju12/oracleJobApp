# Never commit a real .env. Set secrets in the host environment.
PORT=3050

# Required in production. At least 16 characters and not a placeholder.
SESSION_SECRET=change-me-in-production

MONGODB_URI=mongodb://127.0.0.1:27017/oracle-hcm-opportunities

# Comma-separated browser origins for credentialed API calls.
# Leave empty when Express serves the built client on the same origin.
# CORS_ORIGIN=http://localhost:5173

# Redis for the Heroku worker. Without it, source refresh runs in the web process.
# REDIS_URL=
# REDIS_TLS_URL=

# Object storage. Default is local files under data/object-storage.
# Production evidence storage should set OBJECT_STORAGE_DRIVER=s3.
# OBJECT_STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_SERVER_SIDE_ENCRYPTION=AES256

# AUTH_RATE_LIMIT_MAX=20
# WRITE_RATE_LIMIT_MAX=60
