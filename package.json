{
  "name": "oracle-hcm-opportunities",
  "version": "1.0.0",
  "description": "Discover and organize Oracle Cloud HCM job openings from direct employer sources",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "dev": "node scripts/dev-memory.js",
    "test": "jest --runInBand --forceExit",
    "test:ci": "jest --ci --runInBand --forceExit",
    "verify:sources": "node scripts/verify-sources.js",
    "heroku-postbuild": "npm install --prefix client --include=dev && npm run build --prefix client",
    "build:client": "npm install --prefix client --include=dev && npm run build --prefix client"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^8.9.3",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/client/"
    ]
  }
}
